[Statedef 1200]
type = A
movetype = A
physics = N
velset = 0, 0
ctrl = 0
anim = 1200
poweradd = 200


[State 210,2]
type = playsnd
trigger1 = time = 0
value = 10,5

[State 210,2]
type = NotHitby
trigger1 = time <= 6
value = SCA

[State 210,2]
type = HitDef
trigger1 = time = 0
priority = 4, Hit			;2 for ??, 3 for M/H att, 4 for L att, 5 for super, 6 fot hyper
;
attr = S,NA			;STAND / NORMAL ATTACK
hitflag = MA			;MIDDLE ATTACK
guardflag = M			;GUARD is MIDDLE /L is LOW
;
animtype = hard	 		;2p ANIM, light", "medium", "hard", "back", "up",    or "diagup"
air.animtype = back			;2p ANIM
ground.type = high
;
damage = 100,10
getpower = 100
GivePower = 30
;
pausetime = 14,14
guard.pausetime = 14,14
;
ground.slidetime = 20
;
ground.hittime = 20
air.hittime = 30
;
guard.hittime = 17
guard.ctrltime =17
;
ground.velocity = -3,-5
air.velocity = -3,-5
guard.velocity = -15
airguard.velocity = -4,-5
air.juggle = 16
;
ground.cornerpush.veloff = -15
guard.cornerpush.veloff = -15
;
sparkxy = 10,-65
;
juggle = 10
hitsound = 19001,2
guardsound = 19003,0
sparkno = 2
guard.sparkno = 3
;
fall = 1
air.fall = 1
fall.recover = 0

[State 250,3]
type = ChangeState
trigger1 = AnimTime = 0
value = 1201
ctrl = 0


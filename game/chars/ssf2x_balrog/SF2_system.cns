; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
;=================== [-3 states] ======================================
[Statedef -3]

;varset
[State -3, var]
type = VarSet
trigger1 = palno = 1 || palno = 2 || palno = 3 || palno = 4 || palno = 5 || palno = 6
var(14) = 0

[State -3, var]
type = VarSet
trigger1 = palno = 7 || palno = 8 || palno = 9 || palno = 10 || palno = 11 || palno = 12
var(14) = 1
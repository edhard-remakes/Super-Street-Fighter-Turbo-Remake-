;===========================================================================
;------------------------------------------------------------------------------------------------------------------------------------
[State -2, Super finish style 1]
type = Explod
triggerall = Win && !WinTime
triggerall = NumExplod(13580) = 0
trigger1 = StateNo = [2000,2999]		;normal 超必殺技
trigger2 = StateNo = [3000,3999]		;EX 超必殺技
anim = F 40
ID = 13580
sprpriority = -3
postype = left
pos = -30,10
bindtime = -1
supermove = 1
ownpal = 1
removetime = 160

[State -2,AssertSpecial]
type = AssertSpecial
triggerall = 1
trigger1 = NumExplod(13580) = 1
flag = NoBarDisplay
flag2 = NoBG
flag3 = NoFG
ignorehitpause = 1

[State -2,AssertSpecial]
type = AssertSpecial
triggerall = 1
trigger1 = NumExplod(13580) = 1
flag = NoMusic
ignorehitpause = 1

; States that are executed when in self's state file (use statedef -2)
;---------------------------------------------------------------------------
;=================== [-2 states] ======================================
[Statedef -2]
[State -2, Var0 set]
;set var(8) is 1 when the round is start
type = VarSet
trigger1 = RoundState < 2        	 ;<--請參考data\triggers.txt中的說明
trigger1 = facing = 1
v = 8
value = 1

[State -2, Var0 set]
;set var(8) is 1 when the round is start
type = VarSet
trigger1 = RoundState < 2         	;<--請參考data\triggers.txt中的說明
trigger1 = facing = -1
v = 8
value = 2


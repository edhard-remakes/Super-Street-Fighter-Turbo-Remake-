;Player 1
p1.pos = 147,24
p1.bg0.anim = -1
p1.bg1.spr = 30000,0
p1.mid.spr = 30000,1
p1.front.spr = 30000,2
p1.shift.spr = -1,-1
p1.range.x = 0,-139
